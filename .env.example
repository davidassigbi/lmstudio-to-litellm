# lmstudio-to-litellm configuration. Copy this file to .env in this directory and fill in real values;

# LM Studio native API base URL on the LM Studio host, e.g. http://192.168.1.50:1234
LMS_BASE_URL=http://<lmstudio-ip>:1234

# Optional LM Studio API token; when set, sent as "Authorization: Bearer <token>"
# on requests to the LM Studio API. Leave empty if your server has no auth.
LMS_API_TOKEN=

# LiteLLM proxy base URL, e.g. http://localhost:4000
LITELLM_BASE_URL=http://<litellm-host>:4000

# Master key for LiteLLM management endpoints (model/new, model/info, model/delete), e.g. sk-...
LITELLM_MASTER_KEY=

# Name of the credential created in LiteLLM that holds the config to connect to LM Studio API, e.g. LM Studio creds
LITELLM_CREDENTIAL_NAME=

# Identifier for sync-managed models; managed entries are recognised by
# the entry having this tag (default: lmstudio-to-litellm)
MODEL_TAG=lmstudio-to-litellm

# Name prefix prepended to created models; managed entries are recognised by
# that name prefix or by MODEL_TAG in litellm_params.tags.
MODEL_PREFIX=

# Seconds between sync cycles (default: 300)
POLL_INTERVAL=300

# Log level for stdout (DEBUG, INFO, WARNING, ...); default INFO.
LOG_LEVEL=INFO

# Seconds per HTTP request (default: 60)
HTTP_TIMEOUT=60
